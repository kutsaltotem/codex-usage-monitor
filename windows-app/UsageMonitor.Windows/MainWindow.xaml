<Window x:Class="CodexUsageMonitor.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kullanım Özeti" Width="350" Height="560" MinHeight="320" MaxHeight="600"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Border Background="{StaticResource CanvasBrush}" BorderBrush="#34465E" BorderThickness="1"
          CornerRadius="14,14,0,0" Padding="12,12,12,10">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="Süper Zeka Kullanımı" Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="RefreshButton" Content="↻" Width="30" Height="30" Padding="0" Margin="0,0,4,0"
                  ToolTip="Yenile · Ctrl+R" AutomationProperties.Name="Kota bilgilerini yenile" FontSize="19" Style="{StaticResource ActionButton}" />
          <Button x:Name="CloseButton" Content="×" Width="30" Height="30" Padding="0"
                  FontSize="19" Foreground="#CBD4DF" Background="#252D38" BorderBrush="#404B59"
                  Style="{StaticResource ActionButton}" ToolTip="Paneli kapat · Esc" AutomationProperties.Name="Paneli kapat" />
        </StackPanel>
        <TextBlock x:Name="SyncStatusText" Visibility="Collapsed" />
      </Grid>

      <Grid Grid.Row="2" Grid.RowSpan="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#141F2D" BorderBrush="#2B3A4D" BorderThickness="1" CornerRadius="9" Padding="3" Margin="0,0,0,12">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button x:Name="QuotaTabButton" Content="Kota" Height="32" Padding="0" BorderThickness="0"
                    Style="{StaticResource ActionButton}" HorizontalAlignment="Stretch" Margin="0,0,2,0" Background="#344A65" />
            <Button x:Name="TokenTabButton" Grid.Column="1" Content="Geçmiş" Height="32" Padding="0" BorderThickness="0"
                    Style="{StaticResource ActionButton}" HorizontalAlignment="Stretch" Margin="2,0,0,0" Background="Transparent" Foreground="#A6B5C8" />
          </Grid>
        </Border>
        <ScrollViewer x:Name="QuotaPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False" IsDeferredScrollingEnabled="False" Padding="0,0,3,0">
          <StackPanel x:Name="ProviderList" />
        </ScrollViewer>
        <Grid x:Name="TokenHost" Grid.Row="1" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <StackPanel x:Name="TokenSummaryHost" Grid.Row="0" />
          <ScrollViewer x:Name="TokenPanel" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" IsDeferredScrollingEnabled="False" Padding="0,0,3,0">
            <StackPanel x:Name="TokenHistoryContent" />
          </ScrollViewer>
        </Grid>
      </Grid>


    </Grid>
  </Border>
</Window>
