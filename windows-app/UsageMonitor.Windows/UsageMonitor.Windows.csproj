<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>..\..\assets\usage-monitor.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>CodexUsageMonitor</AssemblyName>
    <Version>0.2.0</Version>
    <Product>AI Usage Bar</Product>
    <RootNamespace>CodexUsageMonitor.Windows</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\assets\usage-monitor.ico" Link="Assets\usage-monitor.ico" CopyToOutputDirectory="PreserveNewest" />
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    <ProjectReference Include="..\UsageMonitor.Core.csproj" />
    <Content Include="..\..\assets\vector\LICENSE-LobeHub.txt" Link="Assets\LICENSE-LobeHub.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
